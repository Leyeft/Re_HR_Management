# ---------------------------------------------------------------------------
# Crewly — production settings template
# Copy these into your hosting platform's "Environment variables" screen.
# Never commit the real values. Values in <angle brackets> are yours to fill in.
# ---------------------------------------------------------------------------

APP_NAME=Crewly
APP_ENV=production
# Generate locally with:  php artisan key:generate --show   (one key, keep it forever)
APP_KEY=<base64:...>
APP_DEBUG=false
# The public address of the app, with https and no trailing slash
APP_URL=https://<your-app-domain>
APP_TIMEZONE=Asia/Bangkok

# Logs go to the platform's log viewer
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# MySQL from your host (or a managed MySQL service)
DB_CONNECTION=mysql
DB_HOST=<db-host>
DB_PORT=3306
DB_DATABASE=<db-name>
DB_USERNAME=<db-user>
DB_PASSWORD=<db-password>

# Sessions (the SPA signs in with a cookie). Same domain for app and API.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=null
# Your domain without https:// (Sanctum treats requests from it as the SPA)
SANCTUM_STATEFUL_DOMAINS=<your-app-domain>

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# Profile photos. "public" needs a persistent volume mounted at storage/app/public,
# otherwise photos disappear on every redeploy. Or use S3-compatible storage:
AVATAR_DISK=public
# AVATAR_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=

# Email (password reset, verification). Until a mail service is set up, keep "log":
# the links are written to the logs instead of being sent. For real email use Brevo's
# HTTPS API (Railway blocks SMTP): MAIL_MAILER=brevo, BREVO_API_KEY=<private>, and
# MAIL_FROM_ADDRESS = a sender verified in Brevo. See DEPLOYMENT.md, section 5.
MAIL_MAILER=log
# BREVO_API_KEY=
MAIL_FROM_ADDRESS="no-reply@<your-app-domain>"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Password for the demo accounts if you seed demo data on the live site.
# The README shows "password" for local use, so pick a private one here
# and share it only with your examiners.
DEMO_PASSWORD=<private-demo-password>
